# --- Private / not for a public repository ---
# Verbatim source job description (real company identity + exact wording).
# The public CLAUDE.md contains an anonymized, paraphrased version instead.
.private/

# --- Data ---
# Raw downloads and large processed data must never be committed.
# Only small, hand-made or explicitly-sampled fixtures under tests/fixtures/
# or a documented, size-bounded sample under data/sample/ are allowed.
data/raw/
data/parquet/
data/warehouse/
data/interim/
data/processed/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!tests/fixtures/**/*.csv
!data/sample/**/*.csv
!data/sample/**/*.parquet

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Credentials ---
kaggle.json
*.pem
*.key
service-account*.json
credentials*.json

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Reports / large generated artifacts ---
reports/figures/*.png
!reports/figures/.gitkeep

# Fixture smoke-test output (scripts/run_fixture_smoke_test.py), spanning
# every phase's pipeline steps as they're added: fully regenerable from the
# committed fixture + code in one command, so it is never committed itself —
# this also keeps it from ever being mistaken for a real dataset card or
# real DQ report. (Named reports/phase01/... in Phase 00-01; moved here in
# Phase 02 once the smoke test started spanning more than one phase.)
reports/fixture_smoke_test/
reports/phase01/fixture_smoke_test/
